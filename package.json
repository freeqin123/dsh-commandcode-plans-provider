{
  "name": "@local/commandcode-plans-provider",
  "version": "0.1.0",
  "private": true,
  "description": "Command Code subscription (Go/GOAT/Pro/Max) provider for dsh: plan-scanned model catalog over /alpha/generate, visual API key setup, and subscription usage limits in the Web UI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeqin123/dsh-commandcode-plans-provider.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-client.mjs && node scripts/smoke-catalog.mjs && node scripts/smoke-protocol.mjs",
    "verify": "npm run typecheck && npm run build && npm run smoke"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "commandcode",
    "commandcode-plans",
    "llm-provider",
    "dsh-bundle"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      },
      "profiles": [
        "web",
        "headless"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
